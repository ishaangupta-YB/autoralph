{
  "name": "autoralph",
  "version": "0.1.0",
  "packageManager": "pnpm@11.9.0",
  "description": "Autonomous coding-agent orchestrator with a real-time Kanban board for Claude Code and OpenCode.",
  "type": "module",
  "author": "Ishaan Gupta",
  "license": "MIT",
  "bin": {
    "autoralph": "dist/cli.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "node dist/cli.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "pnpm run build && vitest run",
    "test:e2e": "pnpm run build && vitest run e2e/",
    "test:coverage": "vitest run --coverage --exclude \"e2e/**\""
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "tsdown": "^0.21.7",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ishaangupta-yb/autoralph"
  },
  "engines": {
    "node": ">=20"
  }
}
